# Copy this file to .env and fill in what you have. Anything left empty is skipped.

# ---- General ----
LAQTA_DB=laqta.db
# Words searched on Amazon and AliExpress (comma separated). Add Arabic words too.
LAQTA_KEYWORDS=headphones,smart watch,perfume,oud,abaya,dress,phone charger,backpack,air fryer,kids toys
LAQTA_USD_TO_SAR=3.75
# Share of your commission given back to users as cashback (0.5 = half)
LAQTA_CASHBACK_SHARE=0.5
# Your website domain(s) allowed to call the API, e.g. https://laqta.sa
LAQTA_CORS_ORIGINS=*
LAQTA_FEEDS_DIR=feeds

# ---- AliExpress Affiliate (portals.aliexpress.com + open.aliexpress.com) ----
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_SHIP_TO=SA

# ---- Amazon.sa Associates – Creators API (Associates Central → Tools → Creators API) ----
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# The "Version" shown next to your credentials (e.g. 3.2). It decides the login address.
AMAZON_CREDENTIAL_VERSION=3.2
# Only if Amazon tells you a different token URL for your credentials:
AMAZON_TOKEN_URL=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.sa
